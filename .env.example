# EverShop Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
# These will override the config/default.json values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evershop
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Shop Configuration
# The base URL for your shop (already set in config files for OneShopCloud)
# SHOP_HOME_URL=https://oneshopcloud.com

# Environment
NODE_ENV=production
